{
  "expo": {
    "name": "CivicConnect Citizen",
    "slug": "civicconnect-citizen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.civicconnect.citizen",
      "infoPlist": {
        "NSCameraUsageDescription": "CivicConnect needs camera access to photograph civic issues.",
        "NSMicrophoneUsageDescription": "CivicConnect needs microphone access to record voice descriptions of civic issues.",
        "NSLocationWhenInUseUsageDescription": "CivicConnect needs your location to attach GPS coordinates to civic issue reports.",
        "NSLocationAlwaysUsageDescription": "CivicConnect uses your location to show nearby civic issues."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d4a1a"
      },
      "package": "com.civicconnect.citizen",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-camera",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d4a1a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-status-bar",
      "expo-audio"
    ],
    "scheme": "civicconnect",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc4c6346-1156-4bd4-9d70-2fad4122a212"
      }
    },
    "owner": "krrishgadekar"
  }
}
