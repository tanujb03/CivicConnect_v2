      "confidence": "low",
      "category": "street_lighting",
      "subcategory": "flickering_light"
    },
    {
      "id": "nyc-light-out",
      "when": {
        "complaint_type": "Street Light Condition",
        "descriptor": {
          "contains": "out"
        }
      },
      "confidence": "medium",
      "category": "street_lighting",
      "subcategory": "light_not_working"
    },
    {
      "id": "nyc-light",
      "when": {
        "complaint_type": "Street Light Condition"
