{
  "mapping_id": "nyc311_to_civic",
  "mapping_version": "0.1.0-draft",
  "source_id": "nyc311",
  "taxonomy_version": "1.0.0-draft",
  "status": "DRAFT_NOT_VERIFIED_AGAINST_DATA",
  "provenance_note": "Rules were written from general knowledge of NYC 311 complaint types/descriptors WITHOUT access to the live dataset (egress blocked). Every rule is a hypothesis. Run `cli profile --source nyc311` on the real file, compare with these rules, and review the coverage report before using any mapped label.",
  "match_fields": [
    "complaint_type",
    "descriptor"
  ],
  "semantics": "first matching rule wins; conditions are case-insensitive; strings = equality; dict = equals/contains/startswith/regex; unmatched = unmapped",
  "rules": [
    {
      "id": "nyc-pothole",
      "when": {
        "complaint_type": "Street Condition",
        "descriptor": {
          "contains": "pothole"
        }
      },
      "confidence": "high",
      "category": "roads",
      "subcategory": "pothole"
    },
    {
      "id": "nyc-street-cond",
      "when": {
        "complaint_type": "Street Condition"
      },
      "confidence": "medium",
      "category": "roads",
      "subcategory": null,
      "note": "other street-condition descriptors: category only"
    },
    {
      "id": "nyc-highway",
      "when": {
        "complaint_type": "Highway Condition"
      },
      "confidence": "medium",
      "category": "roads",
      "subcategory": null
    },
    {
      "id": "nyc-sidewalk",
      "when": {
        "complaint_type": "Sidewalk Condition"
      },
      "confidence": "medium",
      "category": "roads",
      "subcategory": "damaged_footpath"
    },
    {
      "id": "nyc-water-quality",
      "when": {
        "complaint_type": "Water Quality"
      },
      "confidence": "medium",
      "category": "water_supply",
      "subcategory": "contaminated_water"
    },
    {
      "id": "nyc-water-nowater",
      "when": {
        "complaint_type": "Water System",
        "descriptor": {
          "contains": "no water"
        }
      },
      "confidence": "medium",
      "category": "water_supply",
      "subcategory": "no_water_supply"
    },
    {
      "id": "nyc-water-pressure",
      "when": {
        "complaint_type": "Water System",
        "descriptor": {
          "contains": "pressure"
        }
      },
      "confidence": "medium",
      "category": "water_supply",
      "subcategory": "low_water_pressure"
    },
    {
      "id": "nyc-water-leak",
      "when": {
        "complaint_type": "Water System",
        "descriptor": {
          "contains": "leak"
        }
      },
      "confidence": "medium",
      "category": "water_supply",
      "subcategory": "pipe_leakage"
    },
    {
      "id": "nyc-water-system",
      "when": {
        "complaint_type": "Water System"
      },
      "confidence": "medium",
      "category": "water_supply",
      "subcategory": null
    },
    {
      "id": "nyc-sewer-backup",
      "when": {
        "complaint_type": "Sewer",
        "descriptor": {
          "contains": "backup"
        }
      },
      "confidence": "medium",
      "category": "drainage_sewerage",
      "subcategory": "sewage_overflow"
    },
    {
      "id": "nyc-sewer-catchbasin",
      "when": {
        "complaint_type": "Sewer",
        "descriptor": {
          "contains": "catch basin"
        }
      },
      "confidence": "medium",
      "category": "drainage_sewerage",
      "subcategory": "blocked_drain"
    },
    {
      "id": "nyc-sewer-manhole-cover",
      "when": {
        "complaint_type": "Sewer",
        "descriptor": {
          "contains": "manhole cover"
        }
      },
      "confidence": "low",
      "category": "drainage_sewerage",
      "subcategory": "missing_manhole_cover"
    },
    {
      "id": "nyc-sewer",
      "when": {
        "complaint_type": "Sewer"
      },
      "confidence": "medium",
      "category": "drainage_sewerage",
      "subcategory": null
    },
    {
