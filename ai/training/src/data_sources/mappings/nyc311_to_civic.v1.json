        "descriptor": {
          "contains": "fallen"
        }
      },
      "confidence": "medium",
      "category": "parks_trees",
      "subcategory": "fallen_tree"
    },
    {
      "id": "nyc-tree-overgrown",
      "when": {
        "complaint_type": "Overgrown Tree/Branches"
      },
      "confidence": "medium",
      "category": "parks_trees",
      "subcategory": "overgrown_vegetation"
    },
    {
      "id": "nyc-tree",
      "when": {
        "complaint_type": {
