          "contains": "missed collection"
        }
      },
      "confidence": "medium",
      "category": "sanitation",
      "subcategory": "missed_garbage_collection"
    },
    {
      "id": "nyc-dirty",
      "when": {
        "complaint_type": "Dirty Conditions"
      },
