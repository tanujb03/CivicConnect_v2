  "tasks": [
    {
      "task": "taxonomy_coverage",
      "capability": "AI-3/AI-5",
      "status": "supported",
      "purpose": "descriptive",
      "max_phase": "at_submission",
      "inputs": [
        "source_category",
        "source_subcategory",
        "category",
        "subcategory"
      ],
      "targets": [],
      "forbidden": [
        "phase:post_triage",
        "phase:post_resolution"
      ],
      "track": "descriptive",
      "notes": "How the dataset's (synthetic) complaint label space lands in taxonomy v1, and which taxonomy labels have no examples."
    },
    {
      "task": "routing_agreement",
      "capability": "AI-3",
      "status": "conditional",
      "purpose": "descriptive",
      "max_phase": "at_submission",
      "inputs": [
        "source_category",
        "source_subcategory",
        "category",
        "subcategory",
        "ward"
      ],
      "targets": [
        "department"
      ],
      "forbidden": [
        "severity",
        "priority",
        "sla_target_hours",
        "assigned_contractor",
        "phase:post_resolution"
      ],
      "track": "synthetic",
      "requires": [
        "department",
        "source_category"
      ],
      "leakage_checks": [
        "target_determinism"
      ],
      "conditions": [
        "report the purity of department given source_category; if >= 0.99 the agreement is vacuous"
      ],
      "notes": "Agreement between the dataset's recorded (synthetic) department, mapped to ours, and our category->department routing. Pipeline test, NOT model accuracy."
    },
    {
      "task": "triage_priority_prior",
      "capability": "AI-3",
      "status": "conditional",
      "purpose": "descriptive",
      "max_phase": "at_submission",
      "inputs": [
        "category",
        "subcategory",
        "ward",
        "latitude",
        "longitude",
        "created_at",
        "filing_channel"
      ],
      "targets": [
        "severity",
        "priority"
      ],
      "forbidden": [
        "department",
        "assigned_contractor",
        "sla_target_hours",
        "phase:post_resolution"
      ],
      "track": "synthetic",
      "requires_any": [
        "severity",
        "priority"
      ],
      "leakage_checks": [
        "target_determinism"
      ],
      "conditions": [
        "severity/priority are generated: a determinism check against category is mandatory",
        "descriptive priors only: no learned triage model is trained on this data"
      ],
      "notes": "Distribution of generated severity/priority by category/ward/time; exercises the priority-prior pipeline, never ground truth."
    },
    {
      "task": "resolution_time_prior",
      "capability": "AI-3/AI-5",
      "status": "conditional",
      "purpose": "descriptive",
      "max_phase": "post_triage",
      "inputs": [
        "category",
        "subcategory",
        "ward",
        "latitude",
        "longitude",
        "created_at",
        "filing_channel",
        "severity",
        "priority",
        "department",
        "sla_target_hours"
      ],
      "targets": [
        "resolution_hours"
      ],
      "forbidden": [
        "assigned_contractor",
        "status",
        "closed_at",
        "resolution_remarks",
        "reassigned",
        "escalated",
        "sla_breached",
        "reopened",
        "citizen_rating",
        "citizen_satisfied"
      ],
      "track": "synthetic",
      "requires_any": [
        "closed_at",
        "resolution_duration"
      ],
      "leakage_checks": [
        "censoring_reported"
      ],
      "conditions": [
        "triage-time information (severity, priority, department, SLA) is legitimately known before resolution",
        "unresolved complaints are right-censored: report the censored share, never silently drop them"
      ],
      "notes": "Resolution-duration distributions per category/ward (generated) to exercise the SLA-reference pipeline."
    },
    {
      "task": "recurrence_hotspot",
      "capability": "AI-5",
      "status": "supported",
      "purpose": "descriptive",
      "max_phase": "at_submission",
      "inputs": [
        "created_at",
        "ward",
        "latitude",
        "longitude",
        "category",
        "subcategory"
      ],
      "targets": [],
      "forbidden": [
        "phase:post_triage",
        "phase:post_resolution"
      ],
      "track": "synthetic",
      "leakage_checks": [
        "split_straddle"
      ],
      "notes": "Stress-test the deterministic recurrence/hotspot definitions (design §38-39) on a large synthetic Mumbai ward-level set."
    },
    {
      "task": "intake_text",
      "capability": "AI-1",
      "status": "conditional",
      "purpose": "evaluation",
      "max_phase": "at_submission",
      "inputs": [
        "description",
        "ward",
        "latitude",
        "longitude",
        "filing_channel"
      ],
      "targets": [
        "category",
        "subcategory"
      ],
      "forbidden": [
        "source_category",
        "source_subcategory",
        "department",
        "severity",
        "priority",
        "phase:post_triage",
        "phase:post_resolution"
      ],
      "track": "none",
      "requires": [
        "description",
        "source_category"
      ],
      "operator_confirmations": [
        "description_is_citizen_text"
      ],
      "leakage_checks": [
        "text_contains_label_rate",
        "split_straddle"
      ],
      "conditions": [
        "the operator must inspect samples and confirm the column is citizen-written free text",
        "source_category (the label) must not be an input",
        "a description that echoes the label is refused"
      ],
      "notes": "Only possible if a genuine citizen description column exists. No such column is known; nothing here claims it does. For the BMC competition data this can never run: the data is synthetic, so the description cannot be confirmed as citizen-written (the adapter refuses --confirm-citizen-text)."
    },
