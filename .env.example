# Copy to `.env` in the REPOSITORY ROOT (same folder as docs/, ai/, backend/). `.env` is gitignored. Never paste keys into chat, issues or commits.
# Real environment variables always override this file.

# ---- free cloud AI (create the keys yourself; both are free and need no card) --------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- model ids (NOT secrets; the ids we use. Copy others from: python -m backend.ai_gateway.providers.live_check --list-models) -------------
# gemini-3.5-flash-lite is the DEV DEFAULT for every text task: 15 requests/min and 500/day on the free tier (2026-10-08).
# gemini-3.5-flash is far scarcer (5/min, 20/day): use it only for a deliberate final run (put it in these variables yourself, then put flash-lite back).
AI_INTAKE_MODEL=gemini-3.5-flash-lite      # vision-capable + JSON schema output; also used for triage / resolution
AI_ANALYTICS_MODEL=gemini-3.5-flash-lite   # analytics explanations
AI_COPILOT_MODEL=gemini-3.5-flash-lite     # tool-calling copilot (falls back to AI_ANALYTICS_MODEL when empty)
AI_EMBEDDING_MODEL=gemini-embedding-001    # cloud embeddings (a local ONNX embedder, when configured, is preferred)
AI_EMBEDDING_DIM=768                       # ask for 768 dimensions; the length is checked and the vector L2-normalised
AI_TRANSCRIPTION_MODEL=whisper-large-v3    # Whisper on Groq
# AI_FALLBACK_TEXT_MODEL=                   # optional: a Groq TEXT model (id from the Groq list) used once when Gemini cannot serve a text call; never for images

# ---- AI budgets and cache --------------------------------------------------------------------------------------------------------------
# Per-model request budgets (rpm/rpd/tpm) default to backend/ai_gateway/providers/model_limits.json. Override, or AI_MODEL_LIMITS=off:
# AI_MODEL_LIMITS=gemini-3.5-flash-lite=15/500/250000,gemini-embedding-001=100/1000/30000
# AI_BUDGET_MAX_WAIT_S=8                    # wait at most this long for a per-minute slot, then degrade
# AI_PROVIDER_TIMEOUT_S=20                  # overall deadline of ONE provider call incl. retries and waits; then the Groq fallback or the rules-based answer (0 or empty = 20)
# AI_REQUEST_DEADLINE_S=30                  # total provider time ONE API request may use (primary + fallback + localisation); when spent the request degrades (0 or empty = 30)
# Cache of successful AI answers in Redis, so demo reruns cost no quota. It STORES citizen text/images/audio answers for the TTL: keep it off for real data.
AI_CACHE_ENABLED=false
# AI_CACHE_TTL_S=86400

# ---- rate limiting -----------------------------------------------------------------------------------------------------------------------
# true ONLY when a proxy or tunnel you control is the sole way into the API (then the client IP is the rightmost X-Forwarded-For entry). Left false behind a
# tunnel, every phone shares the tunnel's address and one per-IP bucket (10 sign-ins/min for everybody); set true on any other path and the header can be spoofed.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ---- push notifications (Expo; free). Remote push does NOT work in Expo Go: use a development build -------------------------------------------------
# EXPO_ACCESS_TOKEN=                        # optional secret (Expo "enhanced push security"); never logged
# PUSH_MAX_DEVICES_PER_USER=10
# PUSH_BATCH_SIZE=100                       # Expo accepts at most 100 messages per request

# ---- upload malware scan (ClamAV; compose profile "scan"; needs about 3 GB of memory) ------------------------------------------------------------------
SCAN_ENABLED=false                          # false: new evidence is marked UNSCANNED. true: it is scanned asynchronously and unscanned/infected files are not served
# CLAMD_HOST=localhost
# CLAMD_PORT=3310

# ---- optional routing / throttling ---------------------------------------------------------------------------------------------------
# AI_ROUTES=intake=gemini,transcription=groq
# AI_GEMINI_RPM=10
# AI_GROQ_RPM=20

# ---- local models (files you train / export; see docs/RUNBOOK_ML.md) ------------------------------------------------------------------
# AI_VISION_ONNX_PATH=ai/artifacts/road_damage/road_damage/best.onnx
# AI_TEXT_ONNX_PATH=ai/artifacts/civic_text_m6/<version>
# AI_EMBED_ONNX_PATH=ai/artifacts/civic_embed_m7/<version>
# AI_LOCAL_CLASSIFIER_PATH=ai/artifacts/civic_text_b0/<version>     # the old B0 fallback

# ---- backend ----------------------------------------------------------------------------------------------------------------------------
# SECRET_KEY=change-me
# POSTGRES_SERVER=localhost

# ---- backend: database, redis, storage, auth (see docs/HANDOFF_LOCAL_SESSION.md "Backend") -----------------------------------------------
# DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/civicconnect     # or POSTGRES_SERVER / POSTGRES_USER / ... ; sqlite:///dev.db works for a quick look
# SECRET_KEY=generate-a-long-random-string          # required when ENVIRONMENT=prod
# ENVIRONMENT=dev
# REDIS_URL=redis://localhost:6379/0                # optional: without it events are skipped
# STORAGE_BACKEND=local                             # local (MEDIA_DIR, signed URLs served by the API) | s3 (MinIO / Supabase / R2)
# MEDIA_DIR=./media
# PUBLIC_BASE_URL=http://localhost:8000             # how a PHONE reaches the API (used in signed upload/download URLs): the LAN address or the tunnel URL, see docs/infra/TUNNEL.md
# CORS_ORIGINS=...                                  # comma separated browser origins, never "*" (credentials are on). The default already allows the local dev servers:
#                                                   #   citizen Vite 5173/5174/5175, admin and overlooker Vite 8080-8082, Expo web 8081 and 19006, 3000, 4173 (vite preview), all on http://localhost
#                                                   # Add, for the deployed apps, one full origin each (scheme + host, no path, no trailing slash), e.g.
#                                                   #   https://<citizen>.vercel.app,https://<admin>.vercel.app,https://<overlooker>.vercel.app,https://<expo-web>.vercel.app
#                                                   # and, when a phone browser opens a dev server over the LAN, http://<LAN-IP>:<port>. The native Expo apps need no CORS entry.
# AI_GATEWAY_STORE=sql                              # sql (default): AI reads/writes the database; demo: synthetic demo city, no database
# S3_ENDPOINT_URL=                                  # STORAGE_BACKEND=s3 only (boto3: backend/requirements-s3.txt)
# S3_BUCKET=civicconnect-evidence
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ---- docker compose stack (infra/compose/docker-compose.yml; docs/infra/COMPOSE.md). Pass this file with: docker compose --env-file .env -f infra/compose/docker-compose.yml ... ----
# POSTGRES_PASSWORD=your_password_here               # compose database password (also used in the backend's DATABASE_URL there)
# API_PORT=8000                                     # host port of the compose backend (a lane uses 8000 + its slot)
# COMPOSE_DB_PORT=5434                              # host ports of the compose services; the defaults avoid civic-db (5433) and civic-redis (6379)
# COMPOSE_REDIS_PORT=6380
# COMPOSE_S3_PORT=8333                              # profile s3
# COMPOSE_CLAMD_PORT=3310                           # profile scan
# COMPOSE_OTLP_GRPC_PORT=4317                       # profile obs (Jaeger UI is on 16686)
# COMPOSE_OTLP_HTTP_PORT=4318
# INSTALL_S3=0                                      # 1 = build the backend image with boto3 (needed with STORAGE_BACKEND=s3)
